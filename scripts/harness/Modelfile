# Модель агента фабрики (Лаб. 3): qwen3:8b з контекстом 16 384 токени.
# Типовий контекст Ollama (4096) менший за системний промпт OpenCode з описом інструментів —
# без цього модель «не бачить» інструментів і відповідає текстом замість дій.
#   ollama create qwen3-8b-16k -f scripts/harness/Modelfile
FROM qwen3:8b
PARAMETER num_ctx 16384
