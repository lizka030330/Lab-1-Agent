+import { describe, expect, it } from 'vitest';
+
+import { citedDocIds } from '../src/rag/cite';
+
+describe('citedDocIds', () => {
+  it('відповідь без цитат дає порожній масив', () => {
+    expect(citedDocIds('Це текст без жодних цитат.')).toEqual([]);
+  });
+
+  it('дві цитати одного документа дають один docId', () => {
+    const answer = 'Текст [korovai#0001] і ще [korovai#0002].';
+    expect(citedDocIds(answer)).toEqual(['korovai']);
+  });
+
+  it('кілька id в одних дужках', () => {
+    const answer = 'Текст [st-nicholas#0000, st-nicholas-day#0005].';
+    expect(citedDocIds(answer)).toEqual(['st-nicholas', 'st-nicholas-day']);
+  });
+
+  it('зберігає порядок першої появи та видаляє дублікати', () => {
+    const answer = 'А [doc-a#0001] Б [doc-b#0002] В [doc-a#0003] Г [doc-c#0000].';
+    expect(citedDocIds(answer)).toEqual(['doc-a', 'doc-b', 'doc-c']);
+  });
+});
