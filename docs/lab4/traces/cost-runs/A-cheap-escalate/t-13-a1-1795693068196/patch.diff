@@ -167,3 +167,23 @@ export function chunkDocument(docId: string, raw: string, rule: ChunkRule = RULE
     text: text.slice(part.span.start, part.span.end),
   }));
 }
+
+export function chunkStats(chunks: readonly Chunk[]): { count: number; avgChars: number; maxChars: number } {
+  if (chunks.length === 0) {
+    return { count: 0, avgChars: 0, maxChars: 0 };
+  }
+  let totalChars = 0;
+  let maxChars = 0;
+  for (const chunk of chunks) {
+    const len = chunk.text.length;
+    totalChars += len;
+    if (len > maxChars) {
+      maxChars = len;
+    }
+  }
+  return {
+    count: chunks.length,
+    avgChars: Math.round(totalChars / chunks.length),
+    maxChars,
+  };
+}
