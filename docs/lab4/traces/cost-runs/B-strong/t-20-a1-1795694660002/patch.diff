+/** Дисперсія генеральної сукупності (середнє квадратів відхилень від mean). */
+export function variance(values: readonly number[]): number {
+  if (values.length === 0) {
+    throw new RangeError('дисперсія порожнього переліку не визначена');
+  }
+  const m = mean(values);
+  return mean(values.map((v) => (v - m) ** 2));
+}
