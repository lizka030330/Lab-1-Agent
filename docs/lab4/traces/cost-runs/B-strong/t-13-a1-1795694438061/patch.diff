@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest';
+
+import type { Chunk } from '../src/rag/chunk';
+import { chunkStats } from '../src/rag/chunk';
+
+function createChunk(text: string, id: string): Chunk {
+  return {
+    id,
+    docId: 'doc-1',
+    heading: '',
+    start: 0,
+    end: text.length,
+    text,
+  };
+}
+
+describe('chunkStats', () => {
+  it('повертає нулі для порожнього масиву', () => {
+    expect(chunkStats([])).toEqual({ count: 0, avgChars: 0, maxChars: 0 });
+  });
+
+  it('три фрагменти довжиною 10, 20 і 25 символів дають { count: 3, avgChars: 18, maxChars: 25 }', () => {
+    const chunks: Chunk[] = [
+      createChunk('a'.repeat(10), 'chunk-1'),
+      createChunk('b'.repeat(20), 'chunk-2'),
+      createChunk('c'.repeat(25), 'chunk-3'),
+    ];
+    expect(chunkStats(chunks)).toEqual({ count: 3, avgChars: 18, maxChars: 25 });
+  });
+});
