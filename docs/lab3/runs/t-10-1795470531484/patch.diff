+import { describe, expect, it } from 'vitest';
+import { tokenize } from '../src/rag/bm25';
+
+describe('tokenize — апострофи в українських словах', () => {
+  it('підтримує всі три форми апострофа (U+0027, U+2019, U+02BC) і зводить їх до U+02BC', () => {
+    const withAscii = tokenize("Пам'ять");
+    const withRightSingle = tokenize('пам’ять');
+    const withModifierLetter = tokenize('памʼять');
+
+    expect(withAscii).toEqual(['памʼять']);
+    expect(withRightSingle).toEqual(['памʼять']);
+    expect(withModifierLetter).toEqual(['памʼять']);
+    expect(withAscii).toEqual(withRightSingle);
+    expect(withRightSingle).toEqual(withModifierLetter);
+  });
+
+  it('ігнорує апострофи на початку та в кінці слова', () => {
+    expect(tokenize("'слово'")).toEqual(['слово']);
+    expect(tokenize('’слово’')).toEqual(['слово']);
+    expect(tokenize('ʼсловоʼ')).toEqual(['слово']);
+
+    expect(tokenize("'пам'ять'")).toEqual(['памʼять']);
+    expect(tokenize('’пам’ять’')).toEqual(['памʼять']);
+    expect(tokenize('ʼпамʼятьʼ')).toEqual(['памʼять']);
+
+    expect(tokenize("'слово")).toEqual(['слово']);
+    expect(tokenize("слово'")).toEqual(['слово']);
+  });
+
+  it('не змінює інші правила (регістр, цифри, відкидання однобуквених токенів)', () => {
+    expect(tokenize("ОБ'ЄМ 123 і E-418")).toEqual(['обʼєм', '123', '418']);
+    expect(tokenize("'a'")).toEqual([]);
+    expect(tokenize("''")).toEqual([]);
+  });
+});
