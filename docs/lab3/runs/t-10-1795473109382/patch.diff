+import { describe, expect, it } from 'vitest';
+
+import { tokenize } from '../src/rag/bm25';
+
+describe('tokenize — обробка апострофа', () => {
+  it('підтримує ASCII апостроф U+0027', () => {
+    expect(tokenize("Пам'ять")).toEqual(['памʼять']);
+  });
+
+  it('підтримує типографський апостроф U+2019', () => {
+    expect(tokenize('пам’ять')).toEqual(['памʼять']);
+  });
+
+  it('підтримує модифікатор апострофа U+02BC', () => {
+    expect(tokenize('памʼять')).toEqual(['памʼять']);
+  });
+
+  it('зводить усі три форми апострофа до одинакового токена з U+02BC', () => {
+    const res1 = tokenize("Пам'ять");
+    const res2 = tokenize('пам’ять');
+    const res3 = tokenize('памʼять');
+    expect(res1).toEqual(['памʼять']);
+    expect(res2).toEqual(['памʼять']);
+    expect(res3).toEqual(['памʼять']);
+  });
+
+  it('ігнорує апостроф на початку або в кінці слова', () => {
+    expect(tokenize("'слово'")).toEqual(['слово']);
+    expect(tokenize('’слово’')).toEqual(['слово']);
+    expect(tokenize('ʼсловоʼ')).toEqual(['слово']);
+    expect(tokenize("'слово")).toEqual(['слово']);
+    expect(tokenize("слово'")).toEqual(['слово']);
+  });
+
+  it('ігнорує апострофи на краях слова з внутрішнім апострофом', () => {
+    expect(tokenize("'пам'ять'")).toEqual(['памʼять']);
+    expect(tokenize('’пам’ять’')).toEqual(['памʼять']);
+    expect(tokenize('ʼпамʼятьʼ')).toEqual(['памʼять']);
+  });
+});
