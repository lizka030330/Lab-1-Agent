+/** precision@k: частка документів серед перших k, що входять у must_cite. */
+export function precisionAtK(hits: readonly Hit[], mustCite: readonly string[], k: number): number {
+  if (k <= 0) {
+    throw new RangeError('precision@k не визначено для k <= 0');
+  }
+  const retrieved = docsAtK(hits, k);
+  if (retrieved.length === 0) {
+    return 0;
+  }
+  const found = retrieved.filter((id) => mustCite.includes(id)).length;
+  return found / retrieved.length;
+}
