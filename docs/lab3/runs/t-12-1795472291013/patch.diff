+import { describe, expect, it } from 'vitest';
+
+import { refusalRate, REFUSAL_TEXT } from '../src/rag/answer';
+
+describe('refusalRate', () => {
+  it('повертає 0, якщо немає жодної відмови', () => {
+    const answers = [
+      'Коровай дарують на весілля. [korovai#0001]',
+      'Рушник є символом дороги та долі. [rushnyk#0002]',
+    ];
+    expect(refusalRate(answers)).toBe(0);
+  });
+
+  it('обчислює частку відмов, якщо частина відповідей є відмовами', () => {
+    const answers = [
+      'Коровай дарують на весілля. [korovai#0001]',
+      REFUSAL_TEXT,
+      'У документах такого немає',
+      'Писанку розписують воском. [pysanka#0003]',
+    ];
+    expect(refusalRate(answers)).toBe(0.5);
+  });
+
+  it('кидає RangeError з повідомленням українською для порожнього масиву', () => {
+    expect(() => refusalRate([])).toThrow(RangeError);
+    expect(() => refusalRate([])).toThrow('Масив відповідей не може бути порожнім');
+  });
+});
