+import { describe, expect, it } from 'vitest';
+
+import { tokenize } from '../src/rag/bm25';
+
+describe('tokenize — апостроф в українських словах', () => {
+  it('підтримує всі три три форми апострофа між літерами (\', ’, ʼ) і зводить до ʼ (U+02BC)', () => {
+    expect(tokenize("Пам'ять")).toEqual(['памʼять']);
+    expect(tokenize('пам’ять')).toEqual(['памʼять']);
+    expect(tokenize('памʼять')).toEqual(['памʼять']);
+  });
+
+  it('не включає апостроф на початку або в кінці слова до токена', () => {
+    expect(tokenize("'слово'")).toEqual(['слово']);
+    expect(tokenize('’слово’')).toEqual(['слово']);
+    expect(tokenize('ʼсловоʼ')).toEqual(['слово']);
+    expect(tokenize("'слово")).toEqual(['слово']);
+    expect(tokenize("слово'")).toEqual(['слово']);
+  });
+
+  it('коректно обробляє апострофи одночасно всередині та на краях слова', () => {
+    expect(tokenize("'пам'ять'")).toEqual(['памʼять']);
+    expect(tokenize('’пам’ять’')).toEqual(['памʼять']);
+    expect(tokenize('ʼпамʼятьʼ')).toEqual(['памʼять']);
+  });
+
+  it('зберігає стандартні правила (нижній регістр, цифри, ігнорування однобуквених токенів)', () => {
+    expect(tokenize("З'їзд 2026 р.")).toEqual(['зʼїзд', '2026']);
+    expect(tokenize("м'ята й 'і'")).toEqual(['мʼята']);
+  });
+});
