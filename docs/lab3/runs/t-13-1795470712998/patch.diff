+import { describe, expect, it } from 'vitest';
+import type { Chunk } from '../src/rag/chunk';
+import { chunkStats } from '../src/rag/chunk';
+
+describe('chunkStats', () => {
+  it('повертає нулі для порожнього масиву', () => {
+    const stats = chunkStats([]);
+    expect(stats).toEqual({ count: 0, avgChars: 0, maxChars: 0 });
+  });
+
+  it('обчислює статистику для трьох фрагментів довжиною 10, 20 і 25 символів', () => {
+    const chunks: Chunk[] = [
+      {
+        id: 'doc#0000',
+        docId: 'doc',
+        heading: '',
+        start: 0,
+        end: 10,
+        text: 'a'.repeat(10),
+      },
+      {
+        id: 'doc#0001',
+        docId: 'doc',
+        heading: '',
+        start: 10,
+        end: 30,
+        text: 'b'.repeat(20),
+      },
+      {
+        id: 'doc#0002',
+        docId: 'doc',
+        heading: '',
+        start: 30,
+        end: 55,
+        text: 'c'.repeat(25),
+      },
+    ];
+
+    const stats = chunkStats(chunks);
+    expect(stats).toEqual({ count: 3, avgChars: 18, maxChars: 25 });
+  });
+});
