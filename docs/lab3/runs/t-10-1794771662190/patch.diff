+  const rawTokens = text.toLowerCase().match(/[\p{L}\p{N}\u0027’ʼ]+/gu) ?? [];
+  const processed: string[] = [];
+  for (const t of rawTokens) {
+    const cleaned = t.replace(/^[\u0027’ʼ]+|[\u0027’ʼ]+$/g, '');
