+import { describe, expect, it } from 'vitest';
+
+import { withinTolerance } from '../src/cost';
+
+describe('withinTolerance', () => {
+  it('повертає true для 110 при фактичних 100 з дефолтним maxPct=10 (включно)', () => {
+    expect(withinTolerance(110, 100)).toBe(true);
+  });
+
+  it('повертає false для 111 при фактичних 100 з дефолтним maxPct=10', () => {
+    expect(withinTolerance(111, 100)).toBe(false);
+  });
+
+  it('повертає true для 105 при 100 з maxPct = 5', () => {
+    expect(withinTolerance(105, 100, 5)).toBe(true);
+  });
+
+  it('повертає false для 106 при 100 з maxPct = 5', () => {
+    expect(withinTolerance(106, 100, 5)).toBe(false);
+  });
+
+  it('кидає RangeError при actual = 0', () => {
+    expect(() => withinTolerance(100, 0)).toThrow(RangeError);
+  });
+});
