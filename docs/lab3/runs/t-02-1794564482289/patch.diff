+import { tokenize } from '../src/rag/bm25'
+
+describe('tokenize function', () => {
+  it('should convert to lowercase and split by punctuation/spaces', () => {
+    const result = tokenize('Hello, world! 123. Привіт.')
+    expect(result).toEqual(['hello', 'world', '123', 'привіт'])
+  })
+
+  it('should remove single-character tokens', () => {
+    const result = tokenize('a, b! c? d.')
+    expect(result).toEqual(['', '', 'c', 'd'])
+  })
+
+  it('should preserve Cyrillic and digits', () => {
+    const result = tokenize('Тест123! Пробіл 456.')
+    expect(result).toEqual(['тест123', 'пробіл', '456'])
+  })
+
+  it('should handle empty input', () => {
+    const result = tokenize('')
+    expect(result).toEqual([])
+  })
+
+  it('should split on multiple delimiters', () => {
+    const result = tokenize('Hello,,world! 123. Test.')
+    expect(result).toEqual(['hello', 'world', '123', 'test'])
+  })
+})
