+/**
+  * Унікальні docId (частина id до символу #) з цитат відповіді,
+  * у порядку першої появи.
+  */
+export function citedDocIds(answer: string): string[] {
+  const docIds: string[] = [];
+  const seen = new Set<string>();
+  for (const id of citedIds(answer)) {
+    const docId = id.split('#')[0];
+    if (docId && !seen.has(docId)) {
+      seen.add(docId);
+      docIds.push(docId);
+    }
+  }
+  return docIds;
+}
