+import { describe, expect, it } from 'vitest';
+
+import { citedDocIds } from '../src/rag/cite';
+
+describe('citedDocIds', () => {
+  it('дві цитати одного документа дають один docId', () => {
+    const answer = 'Текст із першою цитатою [korovai#0001] та другою цитатою [korovai#0003].';
+    expect(citedDocIds(answer)).toEqual(['korovai']);
+  });
+
+  it('кілька id в одних дужках', () => {
+    const answer = 'Текст із кількома цитатами [st-nicholas#0000, st-nicholas-day#0005].';
+    expect(citedDocIds(answer)).toEqual(['st-nicholas', 'st-nicholas-day']);
+  });
+
+  it('відповідь без цитат дає порожній масив', () => {
+    const answer = 'Просто текст відповіді без жодних цитат.';
+    expect(citedDocIds(answer)).toEqual([]);
+  });
+});
