+import { describe, expect, it } from 'vitest';
+
+import { refusalRate, REFUSAL_TEXT } from '../src/rag/answer';
+
+describe('refusalRate', () => {
+  it('повертає 0, якщо немає жодної відмови', () => {
+    const answers = [
+      'Дарувати коровай — давня традиція [korovai#0001].',
+      'Квіти дарують у непарній кількості [flowers#0002].',
+    ];
+    expect(refusalRate(answers)).toBe(0);
+  });
+
+  it('повертає частку відмов, коли частина відповідей містить відмову', () => {
+    const answers = [
+      REFUSAL_TEXT,
+      'Традиційно дарують вишиванку [shirt#0005].',
+      'У документах цього немає',
+      'Гарний подарунок [gift#0001].',
+    ];
+    expect(refusalRate(answers)).toBe(0.5);
+  });
+
+  it('викидає RangeError для порожнього масиву', () => {
+    expect(() => refusalRate([])).toThrow(RangeError);
+    expect(() => refusalRate([])).toThrow('Масив відповідей не може бути порожнім');
+  });
+});
