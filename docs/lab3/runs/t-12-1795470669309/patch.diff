diff --git a/src/rag/answer.ts b/src/rag/answer.ts
index fdf3758..0a276ab 100644
--- a/src/rag/answer.ts
+++ b/src/rag/answer.ts
@@ -38,3 +38,10 @@ export function buildUserMessage(query: string, context: string): string {
 export function isRefusal(answer: string): boolean {
   return answer.includes(REFUSAL_TEXT) || /у документах (колекції )?(цього|такого) немає/i.test(answer);
 }
+
+export function refusalRate(answers: readonly string[]): number {
+  if (answers.length === 0) {
+    throw new RangeError('Масив відповідей не може бути порожнім');
+  }
+  return answers.filter(isRefusal).length / answers.length;
+}
