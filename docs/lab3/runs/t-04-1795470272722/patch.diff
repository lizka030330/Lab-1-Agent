+import { describe, expect, it } from 'vitest';
+
+import { searchInput } from '../src/mcp/tools';
+
+describe('межі схеми searchInput (src/mcp/tools.ts)', () => {
+  it('topK = 0 відхиляється', () => {
+    expect(searchInput.safeParse({ query: 'тест', topK: 0 }).success).toBe(false);
+  });
+
+  it('topK = 2.5 (не ціле) відхиляється', () => {
+    expect(searchInput.safeParse({ query: 'тест', topK: 2.5 }).success).toBe(false);
+  });
+
+  it('topK = 10 приймається', () => {
+    expect(searchInput.safeParse({ query: 'тест', topK: 10 }).success).toBe(true);
+  });
+
+  it('query рівно з 500 символів приймається', () => {
+    const query = 'a'.repeat(500);
+    expect(searchInput.safeParse({ query }).success).toBe(true);
+  });
+});
